# ==========================================
# UNIFIED ENVIRONMENT VARIABLES (Fast-Ingles)
# ==========================================
# Instructions:
# 1. Copy this file to '.env' in the project root.
# 2. Fill in your SECRETS.
# 3. DO NOT COMMIT '.env' to Git.

# --- 1. POSTGRESQL DATABASE (Self-Hosted) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_strong_password
POSTGRES_DB=fastingles
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- 2. SECURITY (Auth & Tokens) ---
# Generate a strong key (e.g., `openssl rand -hex 32`)
SECRET_KEY=change_this_to_a_very_long_random_secret_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- 3. STORAGE (MinIO / S3) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fastingles-assets
MINIO_SECURE=false

# --- 4. AI PROVIDERS ---
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=

# --- 5. APPLICATION CONFIG ---
APP_NAME=Fast-Ingles
APP_VERSION=1.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
LOG_LEVEL=INFO
DEBUG=false

# --- 6. FRONTEND (Vite Build Time) ---
VITE_API_URL=http://localhost:8000
